            "text": "{\"code\":0,\"data\":{\"book_list\":[{\"abstract\":\"（控勿，超洁勿，超敏群勿，视角，，勿，未勿）\\n绿茶偏执阴暗二温柔\\n温宁群亮，温柔漂亮善。课挤廊，，包括永站角落沉默\\n——陆。\\n深造，段彻底封存。\\n某，视野突飘弹幕：\\n——“二怜，守护辈，。”\\n——“？怎，式。”\\n——“惜，注。”\\n——“，……温宁？”\\n震，顺弹幕指引，谓“”，陆。\\n陆温柔贴，深二，注守护，完。\\n系统诉：完务，。\\n找温宁，规则睹透墙，永找。\\n注。\\n陆伪装，偏执阴暗藏温柔皮，按班扮演深配角。\\n陆，装，骨早烂透。\",\"author\":\"妖精幸运猫\",\"book_id\":\"7643830276526722110\",\"book_name\":\"弹幕\",\"creation_status\":0,\"last_chapter_time\":\"1784591390\",\"read_count\":\".读\",\"status\":0,\"thumb_uri\":\"novel-pic/p2oe7f7389adb66366cab093bf9163139fc\",\"thumb_url\":\"http://p3-reading-sign.fqnovelpic.com/novel-pic/p2oe7f7389adb66366cab093bf9163139fc~tplv-resize:200:260.image?lk3s=68b6d46a\\u0026x-expires=1785762529\\u0026x-signature=3%2FDR9bb4q3fHO2nU5B1Uvv5BakA%3D\",\"word_count\":\".\"},{\"abstract\":\"（完）【校园｜竹二｜火葬】\\n，沈雨棠，校园漂亮恶毒配。\\n，千姐，卑微追求穷傅寒，掏掏肺，钱买衣服，钱奶奶治病，砸钱捧科技贵。\\n傅寒始终熟视睹，冷淡冰。\\n，追！\\n初傅寒毫乎，八评：“欲擒故纵，。”\\n，傅寒睛红，卑微冲沈雨棠拍，“沈雨棠，跟？喜欢吗？”\\n哪料，竟桀骜爷贺烬，唇吻痕，嘲讽：\\n“找朋，欠揍啊？”\\n-\\n沈雨棠跟竹——贺烬。\\n曾，贺烬追求傅寒，冷嘲讽：“睛瞎，脑抽。”\\n，贺烬紧紧搂腰，低哄：“，，嗯？”\\n-\\n【，落】\",\"author\":\"野狐\",\"book_id\":\"7640429134237142041\",\"book_name\":\"漂亮配醒，冷校草悔\",\"creation_status\":0,\"last_chapter_time\":\"1785340756\",\"read_count\":\".读\",\"status\":0,\"thumb_uri\":\"novel-pic/p2of686406be2239924cca573c9a9a4e8a2\",\"thumb_url\":\"http://p3-reading-sign.fqnovelpic.com/novel-pic/p2of686406be2239924cca573c9a9a4e8a2~tplv-resize:200:260.image?lk3s=68b6d46a\\u0026x-expires=1785762529\\u0026x-signature=qD41kICthyxvxsooIcvOgZjlrA0%3D\",\"word_count\":\".\"},{\"abstract\":\"【偏执/帝王】【虐】\\n（短剧线）沙，嫁。\\n——\\n青梅竹郎永留漠，嫁晋。\\n\\n漠留周，艳扬嫡凋零晋。\\n\\n“周烨，食言”\\n“抱歉，臣食言”\\n——\\n“景泽辰，愿复”\\n“，哪怕，跟朕葬”\\n\\n【疯狂卑微，未，二】\\n（洁，慎！！！宫宫斗）\\n（深宫群互救赎）\\n（朝均架空）\",\"author\":\"夢醒\",\"book_id\":\"7290525108404227128\",\"book_name\":\"烨\",\"creation_status\":0,\"last_chapter_time\":\"1708764302\",\"read_count\":\".读\",\"status\":0,\"thumb_uri\":\"novel-pic/p2oc63912b91aed36f86e66d179066c6104\",\"thumb_url\":\"http://p3-reading-sign.fqnovelpic.com/novel-pic/p2oc63912b91aed36f86e66d179066c6104~tplv-resize:200:260.image?lk3s=68b6d46a\\u0026x-expires=1785762529\\u0026x-signature=ahXwR2QECGVuKJVzKhbm%2Baky82E%3D\",\"word_count\":\".\"},{\"abstract\":\"庄昂，谓，，考试，离异，组庭，爹疼娘。\\n仅八，庄昂检查患绝症，仅剩寿。\\n，庄昂决释叛逆野，。\\n翻围墙逃，偶遇苏雨蝶，段旅程，束照。\",\"author\":\"卧北\",\"book_id\":\"7272412571779468340\",\"book_name\":\"剩，请容赴\",\"creation_status\":0,\"last_chapter_time\":\"1721655091\",\"read_count\":\".读\",\"status\":0,\"thumb_uri\":\"novel-pic/p2oba61c040dc7658002a1760a35426b3fb\",\"thumb_url\":\"http://p3-reading-sign.fqnovelpic.com/novel-pic/p2oba61c040dc7658002a1760a35426b3fb~tplv-resize:200:260.image?lk3s=68b6d46a\\u0026x-expires=1785762529\\u0026x-signature=8GCCEv5LAfUKUhRJesuQxj%2F7YUY%3D\",\"word_count\":\".\"},{\"abstract\":\"（双洁+熟熟欲+龄差+引导型）\\n【妖精甜妹  纯败类】\\n穿虐，婚约，兄弟，床偷。\\n联姻哄绿茶，转推禁欲兄弟照顾。\\n照顾，照顾床。\\n鹤司忱纤尘染，寡欲疏离鹤医。\\n司绵鹤司忱清辈，脏脏。\\n鹤司忱圣，。\\n婚约废，未婚破防。\\n“未婚妻！”\\n鹤司忱抱，嗓慵懒：“。”\\n“？”\\n鹤司忱：“嫂。”\\n“送，求照顾。”\\n-\\n鹤司忱辈狗，司绵断崖。\\n素矜贵攥腕跪床沿，尾猩红。\\n“引诱伦类，嫌腻？ ”\\n“司绵，连玩弄玩虎蛇尾。”\\n“衣冠禽兽跪狗。”\\n“考证，合宠，求捡。”\\n食指南：\\n退，退疯。\\n非传统，配极精致义。\\n蜜桃糯米团，际底线灵顶级操盘。\\n私选择兜底，疯狂\",\"author\":\"洛汀序\",\"book_id\":\"7636894338433174552\",\"book_name\":\"禁欲，夜沉溺\",\"creation_status\":0,\"last_chapter_time\":\"1783697805\",\"read_count\":\".读\",\"status\":0,\"thumb_uri\":\"novel-pic/p2o7c2de67c99590908d027058ce8803090\",\"thumb_url\":\"http://p3-reading-sign.fqnovelpic.com/novel-pic/p2o7c2de67c99590908d027058ce8803090~tplv-resize:200:260.image?lk3s=68b6d46a\\u0026x-expires=1785762529\\u0026x-signature=Aa7aDFpzvOG7xKWM4wsoFzcoLHk%3D\",\"word_count\":\".\"},{\"abstract\":\"：区留豪娇养\\n【伦钱禁欲佬 × 软乖纯留】\\n【双洁/型差/龄差/极致娇养/纯甜虐】\\n深秋伦敦雨夜，沈予错末班铁，独缩街角，淋湿猫。\\n辆挂私密牌照黑轿缓缓停。窗降，露深邃冷峻、极具压迫贵族孔。\\n泽·莱，，百袭爵， 塔顶端掌权。\\n、深沉、禁欲制，未暧昧。留瞬，沉寂狠狠震颤。\\n“吧，。冷。”\\n低沉磁式，沈予异句温柔。\\n，泰晤河畔落归，百庄园壁炉燃。\\n钱，极致耐偏，胆腼腆留，步步诱怀，娇养。\\n【阅读指南】\\n. 攻纯伦钱贵族，袭爵，低调且权势滔。\\n. 双洁，双唯，，甜尾！\\n. 深邃攻 × 纤细嫩\\n. 钱式娇养：暴户砸钱，刻骨优雅富\",\"author\":\"谵妄\",\"book_id\":\"7649043437987056664\",\"book_name\":\"区留豪娇养\",\"creation_status\":0,\"last_chapter_time\":\"1783564194\",\"read_count\":\".读\",\"status\":0,\"thumb_uri\":\"novel-pic/p2oa56fc19aa702a144a554330cf64ca13a\",\"thumb_url\":\"http://p3-reading-sign.fqnovelpic.com/novel-pic/p2oa56fc19aa702a144a554330cf64ca13a~tplv-resize:200:260.image?lk3s=68b6d46a\\u0026x-expires=1785762529\\u0026x-signature=mlXD6uqMjLIQoOGzKF3FL81lq40%3D\",\"word_count\":\".\"},{\"abstract\":\"【渴肤症清冷×离焦虑阴湿狗】\\n星沉藏秘密，辈瞒秦戈，偏偏患秦戈皮肤饥渴症，刻靠近秦戈，整缩怀，肌肤贴。\\n偏偏，秦戈恐，苗毫留掐灭，继续留秦戈，星沉藏念，控制病，始步步计划，离秦戈。\\n收秦戈优待。\\n秦戈始疯。\\n遍遍够吗？\",\"author\":\"红豆红豆沙\",\"book_id\":\"7651226117482761278\",\"book_name\":\"渴肤症，兄弟怀\",\"creation_status\":0,\"last_chapter_time\":\"1785427840\",\"read_count\":\".读\",\"status\":0,\"thumb_uri\":\"novel-pic/p2o598bd9be922aaad78efe9d0c9ef77c2e\",\"thumb_url\":\"http://p3-reading-sign.fqnovelpic.com/novel-pic/p2o598bd9be922aaad78efe9d0c9ef77c2e~tplv-resize:200:260.image?lk3s=68b6d46a\\u0026x-expires=1785762529\\u0026x-signature=P7FGRSwSY3qRLSY6tnsTKQiGjc4%3D\",\"word_count\":\".\"},{\"abstract\":\"刚涨~\\n【+甜宠+随+爹系糙痞娇包萌妹+龄差】\\n温倒，姐夜喊资，托系塞假婚，随避。\\n待，靠椅背办：“材料，属。”\\n姑娘红：“……哥。”\\n，喊哥哥，答跟领证。\\n宋庭岳曾温养，妹妹捧养。领，伤透。\\n找，，区惹。\\n-\\n整区宋团宝贝疙瘩。\\n黄沙漫北，养嫩嫩，灵。\\n，训兵凶猛虎，蹲哄：“柠柠，挑食，肉。”\\n温佳柠赌：“宋庭岳，喜欢，凭管？”\\n宋庭岳：“妹妹，管。”\\n温佳柠烦，始故跟干。\\n穿薄衬衫晃，湿跟凑，饭咬筷，脸模。\\n，穿红裙，帮兵哥哥睛。\\n夜，姑娘堵墙角，粗鲁哭，暗吓：“怎，骑脖，骑？”\",\"author\":\"旺跳\",\"book_id\":\"7628964470684912664\",\"book_name\":\"糙汉官北养娇包\",\"creation_status\":0,\"last_chapter_time\":\"1782909155\",\"read_count\":\".读\",\"status\":0,\"thumb_uri\":\"novel-pic/p2oda86ee12a9160648e117f92ec0bd060a\",\"thumb_url\":\"http://p3-reading-sign.fqnovelpic.com/novel-pic/p2oda86ee12a9160648e117f92ec0bd060a~tplv-resize:200:260.image?lk3s=68b6d46a\\u0026x-expires=1785762529\\u0026x-signature=KHDV1IXh%2FvKj6QJPdZx1jR6H9Kw%3D\",\"word_count\":\".\"},{\"abstract\":\"【线，欢迎收~】【增番】\\n《夏乔木雅堂》籽阔，首。穿越空元翩翩优质叔。突消，？\\n坐趟黑，隧堵，江倩兮“空折叠”影桥段撞！短短，。\\n顾池，容易追霸，浓蜜腻歪帅，夜，业、翩翩儒雅叔！“组庭、婚”？！降顶绿帽，偏偏反抗。\\n吗？\\n消吗？\\n\",\"author\":\"籽 著\",\"book_id\":\"6985039308503649293\",\"book_name\":\"亮，（增番）\",\"creation_status\":0,\"last_chapter_time\":\"1774412297\",\"read_count\":\".读\",\"status\":0,\"thumb_uri\":\"novel-pic/b29a58dc0997617575518e74a5c5f935\",\"thumb_url\":\"http://p3-reading-sign.fqnovelpic.com/novel-pic/b29a58dc0997617575518e74a5c5f935~tplv-resize:200:260.image?lk3s=68b6d46a\\u0026x-expires=1785762529\\u0026x-signature=q27kUotiOQZOPgHGYf8jHzRKlXg%3D\",\"word_count\":\".\"},{\"abstract\":\"【顶级魅魔顶级醋王】\\n【娱圈顶流星京圈恋脑霸】\\n【爽+娱圈+穿+脸+综艺+双强+超级甜】\\n鱼考状元，赶庆功宴辆货创飞。\\n醒早玛丽苏甜宠恶毒配，境优渥漂亮，非抢装货影帝，众厌弃恶毒配。\\n穿坐考考，摆干干净净考卷。\\n哟呵？专业吗？\\n---\\n网：据爆料您考绩惊。\\n鱼：哦，屏蔽\\n---\\n网：姐暗恋乔影帝，系影帝……\\n鱼：钱模？\\n---\\n导演：观众投票鱼简辞组……\\n孟周：投凭投票截图孟氏集团领钱\\n观众：豹豹猫猫啦！\",\"author\":\"祈舟舟\",\"book_id\":\"7526812477347073086\",\"book_name\":\"考状元穿娱圈黑红星\",\"creation_status\":0,\"last_chapter_time\":\"1784628440\",\"read_count\":\".读\",\"status\":0,\"thumb_uri\":\"novel-pic/p2oee8d1b7b9935d932884cd834bbca057c\",\"thumb_url\":\"http://p3-reading-sign.fqnovelpic.com/novel-pic/p2oee8d1b7b9935d932884cd834bbca057c~tplv-resize:200:260.image?lk3s=68b6d46a\\u0026x-expires=1785762529\\u0026x-signature=1L53YASYVCvU3jqU4bkE%2BjbJAnA%3D\",\"word_count\":\".\"},{\"abstract\":\"【二+婚+闺蜜叔超宠+火葬+虐渣+脸】\\n【禁欲绝嗣嘴硬哥×清醒艳娇】\\n婚，林苒视若珍宝婚姻精策划骗局。\\n婚证假，丈假，\\n连尽责孝俸，假。\\n，千辛苦试管，。\\n养斥责：“苒苒，姐姐，替妹妹怎？”\\n骗骗渣：“林苒，除，。”\\n林苒噙淡，“？败裂？”\\n-\\n江抱错千，惜跟商绝嗣联姻。\\n领证，\\n冷提醒，“求，。”\\n林苒莞：“商，您。”\\n绝嗣佬，竟闺蜜冷叔。\\n误误撞，竟绝嗣叔崽！\\n-\\n，婚约。\\n林苒：“叔，空，政局办离婚续？”\\n谁腹黑，凉薄指尖抬巴：“谁叔？”\\n“乖，。”\\n“，跑哪？”\\n初，步步沦陷，瘾。\",\"author\":\"漫\",\"book_id\":\"7568780818131192857\",\"book_name\":\"骗领假证？转嫁绝嗣叔虐哭\",\"creation_status\":0,\"last_chapter_time\":\"1767416694\",\"read_count\":\".读\",\"status\":0,\"thumb_uri\":\"novel-pic/508f84949a62803f4bc57b3d1e7e1836\",\"thumb_url\":\"http://p3-reading-sign.fqnovelpic.com/novel-pic/508f84949a62803f4bc57b3d1e7e1836~tplv-resize:200:260.image?lk3s=68b6d46a\\u0026x-expires=1785762529\\u0026x-signature=RoK%2F%2FwglY1YMjGxzYotLWcdQbyY%3D\",\"word_count\":\".\"},{\"abstract\":\"（完）【静温软乖巧酷拽撩】\\n【校园+钟+暗恋+甜撩+双洁】\\n季辞夜，骄般存。\\n喜欢计，林雾桐撞。\\n卫廊，甜喜欢类型。\\n片刻沉默，清晰，“乖。”\\n-\\n林雾桐，典型乖乖，乖纯。\\n宴，闯休息室，误误撞换衣服季辞夜。\\n慌忙歉逃离，截退。\\n耳落撩低。\\n季辞夜系衬衫纽扣，慢，“，？”\\n\\n——\\n毕业，云季辞夜踏京校园。\\n崇拜妹脸奇惊讶，“，您怎突校？”\\n季辞夜：“朋。”\\n初，季校草秘京传沸沸扬扬，谁扒息。\\n今妹胆追，“您传绯闻朋吗？”\\n银戒指阳泛耀芒，唇角弧肆羁，“嗯，。”\\n。\\n。\\n涩恋，懵懂悸，共，属。\",\"author\":\"蜜桃甜\",\"book_id\":\"7645303606110850073\",\"book_name\":\"暗恋喜欢乖乖！\",\"creation_status\":0,\"last_chapter_time\":\"1784455271\",\"read_count\":\".读\",\"status\":0,\"thumb_uri\":\"novel-pic/p2o35fa8536b12cbb5775421bd88195036f\",\"thumb_url\":\"http://p3-reading-sign.fqnovelpic.com/novel-pic/p2o35fa8536b12cbb5775421bd88195036f~tplv-resize:200:260.image?lk3s=68b6d46a\\u0026x-expires=1785762529\\u0026x-signature=TdqPj55TFrNVDdG2lYR54g2gXuc%3D\",\"word_count\":\".\"},{\"abstract\":\"【京圈爷纯欲】\\n［双洁+钟+极致扯+棋逢］\\n京城顶级权贵圈晓，周爷周妄副勾魂皮。\\n鎏火指尖翻飞溅星火，尾颗泪痣晃欲。\\n玩弄猎，未哪千近。\\n沈雪窈陪朋“欲燃”，爷拦，端杯“沦陷”调，众爷择偶标准。\\n——\\n桀骜驯爷，“宝宝，。”\\n“宝宝，随撩。”\\n“宝宝，今晚？”\\n“宝宝，  ……”\\n“宝宝，雪菊枸杞茶，消消火？”\\n“宝宝，今穿颜？”\\n“宝宝，今晚该收专费…”\\n……\\n【剧】\\n粉丝蹲周妄凌晨酒吧铲雪。\\n评论区狂刷：【赌链！肯堆雪哄婆！】\\n画转——\\n握沈雪窈脚踝，扯丝睡裙：“祖宗，谁初雪夜堆雪，足愿？”\\n^愿钩，低^\",\"author\":\"甜咬栗\",\"book_id\":\"7628889555789171774\",\"book_name\":\"京圈爷：宝宝勾勾\",\"creation_status\":0,\"last_chapter_time\":\"1783345426\",\"read_count\":\".读\",\"status\":0,\"thumb_uri\":\"novel-pic/p2o6cabab59304367f0afa51c05a2306850\",\"thumb_url\":\"http://p3-reading-sign.fqnovelpic.com/novel-pic/p2o6cabab59304367f0afa51c05a2306850~tplv-resize:200:260.image?lk3s=68b6d46a\\u0026x-expires=1785762529\\u0026x-signature=pWUSv8Qf%2FkAIqPuZqRa0gOH6Jgc%3D\",\"word_count\":\".\"},{\"abstract\":\"贪财迷糊腹黑掌权（评涨）\\n孟静穿，顶级财阀恶毒秘。\\n著职务，屡陷害，且浑勾引，甚药，企图挟。\\n败露扔区，嫁二棍，夜喂猪摔猪圈，猪咬。\\n孟静障碍，婚。\\n朝穿，孟静兢兢业业扮演秘角，疯狂攒钱准备跑。\\n递笔，冒送药，越，评价二孝秘。\\n，剧孟静药剧。\\n！药怎压？\\n孟静吓赶紧提跑，控彻底盯。\\n冷淡吗？怎夜七啊！\\n-\\n千，终调，孟静刻跑，店喜滋滋卡余额，幻今夜夜笙歌模，堵。\\n孟静：“今婚吗？”\\n裴淮京冷：“娘跑，哪婚？”\\n裴淮京护短，裴淮京护孟静，怜惜纪，纵容。\\n即骗奢侈品折。\\n裴淮京：骗骗？嗯，\",\"author\":\"招财猫喵咪\",\"book_id\":\"7623007618532903960\",\"book_name\":\"穿财阀秘\",\"creation_status\":0,\"last_chapter_time\":\"1783338571\",\"read_count\":\".读\",\"status\":0,\"thumb_uri\":\"novel-pic/p2oacc81351271b64db78a0a22a744dd8c0\",\"thumb_url\":\"http://p3-reading-sign.fqnovelpic.com/novel-pic/p2oacc81351271b64db78a0a22a744dd8c0~tplv-resize:200:260.image?lk3s=68b6d46a\\u0026x-expires=1785762529\\u0026x-signature=pKJR1Dw7KdwdzQwSrnnqwrVKlXM%3D\",\"word_count\":\".\"},{\"abstract\":\"【久逢＋二婚＋流＋熟熟＋庭＋萌宝＋甜宠＋救赎 】\\n\\n离异清冷旅社板  野帅王酒吧板\\n\\n\\n模闺蜜舅，且喝醉撒欢夜，验？\\n\\n\\n\\n\\n\\n反，姝二酒醒床，拿包跑。\\n\\n\\n江越冷脸：“睡完跑，玩？”\\n\\n\\n\\n姝顾脸，包掏块钱甩脸：\\n\\n\\n“，钱。\\n\\n\\n市流富婆，件。”\\n\\n\\n\\n脸愠怒，咬牙：“姝，居敢鸭？”\\n\\n\\n\\n—\\n\\n\\n\\n江越，姝初恋。\\n\\n\\n，差“故”。\\n\\n\\n足证，劲。\\n\\n\\n闺蜜赵珂，王，富。\\n\\n\\n姝玩，，拒绝。\\n\\n\\n，婚且离婚。\\n\\n\\n赵珂：“早姝姝狗，初介绍婚。\\n\\n\\n虽，愿庭负责。”\\n\\n\\n江越嘲讽：“闺蜜，装纯贪慕虚荣货，倒贴钱娶。”\\n\\n，啪啪脸：“宝贝，求嫁。”\\n\\n王收，二婚遇故。\",\"author\":\"叶氤\",\"book_id\":\"7559957733902928921\",\"book_name\":\"贪欢瘾\",\"creation_status\":0,\"last_chapter_time\":\"1768115489\",\"read_count\":\".读\",\"status\":0,\"thumb_uri\":\"novel-pic/1474a70e4ec7f1df85986421d3699592\",\"thumb_url\":\"http://p3-reading-sign.fqnovelpic.com/novel-pic/1474a70e4ec7f1df85986421d3699592~tplv-resize:200:260.image?lk3s=68b6d46a\\u0026x-expires=1785762529\\u0026x-signature=O09JZIkbZEatUP9JhXBrF%2Fq7UtM%3D\",\"word_count\":\".\"},{\"abstract\":\"（售）\\n【婚➕龄差➕香➕细流➕双洁】\\n*：偏。\\n*\\n幼，禾薄伤彻底。\\n值京北极端暴雪，抱陪玩偶，孤零零，雪肆虐，冻僵昏厥。\\n停辆宾，座推，禾抱怀，紧急复温，送医院。\\n禾醒，妥善置，赴。\\n*\\n逢。\\n禾婚约竟坛煜，夺。\\n婚，屈指。\\n禾晓，煜弟，疏离冷。\\n婚，图各。\\n倒霉早，钥匙丢，坏掉。\\n专驶，窗降，座端矜贵：“需捎段吗？”\\n禾蹭煜。\\n蹭蹭，思，终修，晚修，睡。\\n翌，。\\n煜迈沉缓步伐，姿态闲适：“近偷贼，。”\\n“偷整辆？”\\n“，贼敢偷。”\\n某禾找，偶藏煜抽屉钥匙。\\n，假矜傲贼。\",\"author\":\"扶鸟\",\"book_id\":\"7418062783700290585\",\"book_name\":\"清语辞\",\"creation_status\":0,\"last_chapter_time\":\"1732550671\",\"read_count\":\".读\",\"status\":0,\"thumb_uri\":\"novel-pic/p2o9352b27bfde01e239a2e4daaa9b28a9b\",\"thumb_url\":\"http://p3-reading-sign.fqnovelpic.com/novel-pic/p2o9352b27bfde01e239a2e4daaa9b28a9b~tplv-resize:200:260.image?lk3s=68b6d46a\\u0026x-expires=1785762529\\u0026x-signature=cfgcvRixNmokXGxYbyUxAOkCQvQ%3D\",\"word_count\":\".\"},{\"abstract\":\"【竞➕游戏播➕➕双救赎】\\n【绿茶撒娇精纯温柔】\\n宁停郁江缘\\n-\\n江缘柿播游戏播，播勤勤恳恳，始终另播压。\\n退役职业选，貌众，操犀，喜欢追队哥哥蓝。\\n粉丝撕热火朝。\\n台，江缘酒醉，滚块。\\n-\\n宁停郁谈段恋，网恋。\\n温柔贴，百依百顺，纯。\\n约，宁停郁鸽。\\n-\\n江缘，近殷勤。\\n“哥哥，野危险，宝宝吧！”\\n“缘哥哥，玩紧刺激王荣耀！”\\n“哥哥，播鸭。”\\n江缘：“……”\\n粉丝：“……？”\\n-\\n温煮八熟，江缘忽绿茶纯洁害。\\n压怀，滚烫，恶劣低语：“哥哥，线蓝，连野怪验。”\\n“猜准备？”\",\"author\":\"麻辣汪\",\"book_id\":\"7588983033936497726\",\"book_name\":\"野线，哭\",\"creation_status\":0,\"last_chapter_time\":\"1781527514\",\"read_count\":\".读\",\"status\":0,\"thumb_uri\":\"novel-pic/p2ofa22cacf255069082164d313ef65b717\",\"thumb_url\":\"http://p3-reading-sign.fqnovelpic.com/novel-pic/p2ofa22cacf255069082164d313ef65b717~tplv-resize:200:260.image?lk3s=68b6d46a\\u0026x-expires=1785762529\\u0026x-signature=8Xi%2B2qNhz3OWtFzZDjByfl3XjtQ%3D\",\"word_count\":\".\"},{\"abstract\":\"【豪爷+甜+妹妹照片骗网恋+追妻火葬+双洁】\\n苏浅胎单，网恋。\\n消息：，八块腹肌，冷皮校草。\\n坏消息：异妹妹冒充。\\n消息：照片妹妹，豪爷江寂。\\n传闻爷冷淡，妹妹牵。\\n苏浅贪财，复妹妹，干脆勾搭江寂。\\n爷胃疼？送早餐！\\n爷喝醉？送！\\n爷？依旧宠。\\n——\\n，苏浅江寂追，算豪婚。\\n，爷疯。\\n冷淡追港城，红，按婚纱照。\\n“浅浅，怀宝宝，抛弃？”\\n.\\n【剧】\\n妹妹：骗，复！\\n爷：骗，。\",\"author\":\"百瓜瓜\",\"book_id\":\"7625274054341053465\",\"book_name\":\"禁欲爷错房，嘴硬软\",\"creation_status\":0,\"last_chapter_time\":\"1784190611\",\"read_count\":\".读\",\"status\":0,\"thumb_uri\":\"novel-pic/p2obe696397dac67c14b9caf8b548386608\",\"thumb_url\":\"http://p3-reading-sign.fqnovelpic.com/novel-pic/p2obe696397dac67c14b9caf8b548386608~tplv-resize:200:260.image?lk3s=68b6d46a\\u0026x-expires=1785762529\\u0026x-signature=6QPdapi6bZVfEywDn2a%2Fz7yUbvg%3D\",\"word_count\":\".\"}],\"has_more\":true,\"total_count\":10000},\"log_id\":\"20260803205848E433237850EF6970485B\",\"message\":\"success\"}"
